POSTGRES_USER=<database username>
POSTGRES_PASSWORD=<database password>
POSTGRES_DB=<database name>

# "db" is the docker-compose service name; keep it as-is. User/password/name
# must match the three values above.
DATABASE_URL=postgres://<database username>:<database password>@db:5432/<database name>?sslmode=disable

BACKEND_PORT=<port the backend API is exposed on, e.g. 4000>
FRONTEND_PORT=<port the frontend is exposed on, e.g. 3000>
